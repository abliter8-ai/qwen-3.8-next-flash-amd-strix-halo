[Unit]
Description=Qwen3.8-Flash-Next on Halogen 0.9.1, with room for Ternary Bonsai
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=5

[Container]
ContainerName=halogen-flash
Image=ghcr.io/peonist-ai/halogen-flash-server@sha256:2322c4d91cd90aae628ac02f7dfd158f078b59789786cdb3297a7bcba2eb0cea
PublishPort=127.0.0.1:8731:8731
AddDevice=/dev/kfd
AddDevice=/dev/dri
SecurityLabelDisable=true
GroupAdd=keep-groups
PodmanArgs=--ipc=host --ulimit memlock=-1:-1 --security-opt seccomp=unconfined
Volume=%h/models/halogen:/models:ro
Volume=%h/models/halogen/tokenizer:/tokenizer:ro
Environment=HALOGEN_API_PORT=8731
Environment=HALOGEN_MODEL_ID=halogen-qwen3.8-flash-next
Environment=HALOGEN_CHECKPOINT=/models/qwen38-flash-next-w4b.hgn
Environment=HALOGEN_CK_OVERLAY=/models/qwen38-flash-next-w4b.overlay.hgn
Environment=HALOGEN_TOKENIZER=/tokenizer
Environment=HALOGEN_VISION_TOWER=/models/qwen38-flash-next-vision.hgn
Environment=HALOGEN_KV_SLOTS=4
Environment=HALOGEN_KV_POOL_POSITIONS=524288
Environment=HALOGEN_CTX=262144
Environment=HALOGEN_MAX_TOK=8192
Environment=HALOGEN_PREFILL_CHUNK=8192
Environment=HALOGEN_PROMPT_CACHE=2
Environment=HALOGEN_DRAFTER_DEFAULT=1
Environment=HALOGEN_PLD=3,3
Environment=HALOGEN_FLASH_PIN_TRUNK=1
Environment=HALOGEN_STARTUP_PROGRESS=1
Environment=HALOGEN_MAX_THINKING_TOKENS=8192
Exec=

[Service]
ExecStartPre=%h/qwen-strix/recipe/co-resident/memgate-halogen.sh
Restart=always
RestartSec=15
TimeoutStartSec=900
TimeoutStopSec=120

[Install]
WantedBy=default.target
